# {{OB_PROJECT_NAME}} - Environment Variables
# Copy this file to .env and configure for your environment

# Application
PROJECT_NAME={{OB_PROJECT_NAME}}
VERSION=1.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT={{PORT}}

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS (comma-separated list)
ALLOWED_ORIGINS=*
